{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capibara.local/contracts/chart_spec.json",
  "title": "chart_spec",
  "type": "object",
  "properties": {
    "type": {
      "enum": [
        "bar",
        "line",
        "area",
        "pie",
        "table",
        "map"
      ]
    },
    "metric": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "metric_code from mart.metric_catalog"
    },
    "x": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        {
          "type": "null"
        }
      ],
      "description": "dim_code from mart.dimension_catalog"
    },
    "series": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        {
          "type": "null"
        }
      ],
      "description": "dim_code; must differ from x (checked by the server)"
    },
    "filters": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": [
            "string",
            "number"
          ]
        }
      }
    },
    "date_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date_to": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "top_n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "sort": {
      "enum": [
        "asc",
        "desc"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 120
    }
  },
  "required": [
    "type",
    "metric"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "map"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "x"
        ],
        "properties": {
          "x": {
            "enum": [
              "customer_state",
              "seller_state"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "line",
              "area"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "x"
        ],
        "properties": {
          "x": {
            "const": "month"
          }
        }
      }
    }
  ]
}
