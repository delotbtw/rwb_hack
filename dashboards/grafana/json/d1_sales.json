    {
      "id": 1,
      "type": "stat",
      "title": "Выручка",
      "description": "Σ price по доставленным заказам, без фрахта (metric_catalog.revenue). Срезы: период, штаты покупателя и продавца, категория. Единица: R$.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "capibara-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "capibara-pg"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT SUM(price) FILTER (WHERE is_revenue) AS revenue\nFROM mart.v_sales_item\nWHERE purchase_month >= date_trunc('month', $__timeFrom()::timestamp) AND purchase_month <= $__timeTo()::timestamp\n  AND ('*' IN ($customer_state) OR customer_state IN ($customer_state))\n  AND ('*' IN ($seller_state) OR seller_state IN ($seller_state))\n  AND ('*' IN ($category) OR category_label IN ($category))"
        }
      ],
      "options": {
