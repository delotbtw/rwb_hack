    {
      "id": 11,
      "type": "table",
      "title": "Сверка batch и stream (последний запуск)",
      "description": "batch_value и stream_value могут быть пустыми, если одна из сторон ещё не посчитана.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "capibara-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
