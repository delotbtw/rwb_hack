{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capibara.local/contracts/events/review.posted.json",
  "title": "review.posted payload",
  "type": "object",
  "properties": {
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "review_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "review_comment_title": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_comment_message": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_created_at": {
      "$ref": "envelope.json#/$defs/timestamp_naive"
    },
    "review_answered_at": {
      "oneOf": [
        {
          "$ref": "envelope.json#/$defs/timestamp_naive"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "review_id",
    "review_score",
    "review_created_at"
  ],
  "additionalProperties": false
}
