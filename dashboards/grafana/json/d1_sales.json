    {
      "id": 7,
      "type": "bargauge",
      "title": "Топ-15 категорий: доля выручки",
      "description": "Доля категории = Σ price категории / Σ price всех категорий на текущем срезе (неаддитивно: пересчитывается при любом фильтре; доли топ-15 в сумме не дают 100 %). Только доставленные заказы.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "capibara-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "capibara-pg"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT\n  COALESCE(category_label, 'Без категории') AS \"Категория\",\n  SUM(price) FILTER (WHERE is_revenue) / NULLIF(SUM(SUM(price) FILTER (WHERE is_revenue)) OVER (), 0) AS \"Доля выручки\"\nFROM mart.v_sales_item\nWHERE purchase_month >= date_trunc('month', $__timeFrom()::timestamp) AND purchase_month <= $__timeTo()::timestamp\n  AND ('*' IN ($customer_state) OR customer_state IN ($customer_state))\n  AND ('*' IN ($seller_state) OR seller_state IN ($seller_state))\n  AND ('*' IN ($category) OR category_label IN ($category))\nGROUP BY 1\nORDER BY 2 DESC NULLS LAST\nLIMIT 15"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "namePlacement": "left",
