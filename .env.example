# Скопируйте в .env (он в .gitignore) и заполните строки с пометкой ЗАПОЛНИТЬ.

# --- LLM: DeepSeek через Yandex AI Studio ---
YANDEX_AI_STUDIO_API_KEY=            # ЗАПОЛНИТЬ: API-ключ сервисного аккаунта, без "Bearer"/"Api-Key"
YANDEX_FOLDER_ID=                    # ЗАПОЛНИТЬ: идентификатор каталога (b1g...)
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_MODEL=deepseek-v4.1-flash          # в запрос уйдёт gpt://$YANDEX_FOLDER_ID/$LLM_MODEL

# --- PostgreSQL (как в кейсе) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=marketplace
PGUSER=hack
PGPASSWORD=hack

# --- Поток / демо ---
REDPANDA_BROKERS=redpanda:9092
DEMO_CUTOFF=2018-08-01
DEMO_DURATION_SEC=60

# --- Поток K2 (make live / demo-replay; compose читает .env сам) ---
KAFKA_BOOTSTRAP=redpanda:9092        # внутри сети compose; запуск с хоста: localhost:19092
BATCH_MAX=500                        # ingestor: максимум сообщений в пачке
BATCH_WAIT_MS=200                    # ingestor: максимум ожидания пачки, мс
CUTOFF=2018-08-01                    # генератор: заказы с purchased_at >= CUTOFF
DURATION=60                          # генератор: длительность реплея, секунд

# --- Grafana / Airflow (локальные учётки только для демо) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
