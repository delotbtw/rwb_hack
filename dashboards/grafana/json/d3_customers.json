          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT\n  COALESCE(to_char(cohort_month, 'YYYY-MM'), 'Все когорты') AS \"Когорта\",\n  SUM(cohort_size) FILTER (WHERE month_offset = 0) AS \"Покупателей\",\n  SUM(active_customers) FILTER (WHERE month_offset = 0)::numeric\n    / NULLIF(SUM(cohort_size) FILTER (WHERE month_offset = 0), 0) AS \"Мес. 0\",\n  SUM(active_customers) FILTER (WHERE month_offset = 1)::numeric\n    / NULLIF(SUM(cohort_size) FILTER (WHERE month_offset = 1), 0) AS \"Мес. 1\",\n  SUM(active_customers) FILTER (WHERE month_offset = 2)::numeric\n    / NULLIF(SUM(cohort_size) FILTER (WHERE month_offset = 2), 0) AS \"Мес. 2\",\n  SUM(active_customers) FILTER (WHERE month_offset = 3)::numeric\n    / NULLIF(SUM(cohort_size) FILTER (WHERE month_offset = 3), 0) AS \"Мес. 3\",\n  SUM(active_customers) FILTER (WHERE month_offset = 4)::numeric\n    / NULLIF(SUM(cohort_size) FILTER (WHERE month_offset = 4), 0) AS \"Мес. 4\",\n  SUM(active_customers) FILTER (WHERE month_offset = 5)::numeric\n    / NULLIF(SUM(cohort_size) FILTER (WHERE month_offset = 5), 0) AS \"Мес. 5\",\n  SUM(active_customers) FILTER (WHERE month_offset = 6)::numeric\n    / NULLIF(SUM(cohort_size) FILTER (WHERE month_offset = 6), 0) AS \"Мес. 6\",\n  SUM(active_customers) FILTER (WHERE month_offset = 7)::numeric\n    / NULLIF(SUM(cohort_size) FILTER (WHERE month_offset = 7), 0) AS \"Мес. 7\",\n  SUM(active_customers) FILTER (WHERE month_offset = 8)::numeric\n    / NULLIF(SUM(cohort_size) FILTER (WHERE month_offset = 8), 0) AS \"Мес. 8\",\n  SUM(active_customers) FILTER (WHERE month_offset = 9)::numeric\n    / NULLIF(SUM(cohort_size) FILTER (WHERE month_offset = 9), 0) AS \"Мес. 9\",\n  SUM(active_customers) FILTER (WHERE month_offset = 10)::numeric\n    / NULLIF(SUM(cohort_size) FILTER (WHERE month_offset = 10), 0) AS \"Мес. 10\",\n  SUM(active_customers) FILTER (WHERE month_offset = 11)::numeric\n    / NULLIF(SUM(cohort_size) FILTER (WHERE month_offset = 11), 0) AS \"Мес. 11\",\n  SUM(active_customers) FILTER (WHERE month_offset = 12)::numeric\n    / NULLIF(SUM(cohort_size) FILTER (WHERE month_offset = 12), 0) AS \"Мес. 12\"\nFROM mart.v_cohort_retention\nWHERE month_offset <= 12\n  AND cohort_month >= date_trunc('month', $__timeFrom()::timestamp) AND cohort_month <= $__timeTo()::timestamp\n  AND ('*' IN ($customer_state) OR first_state IN ($customer_state))\n  AND ('*' IN ($category) OR first_category IN ($category))\nGROUP BY GROUPING SETS ((cohort_month), ())\nORDER BY GROUPING(cohort_month) DESC, cohort_month"
        }
      ],
