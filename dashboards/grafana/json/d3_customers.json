          "editorMode": "code",
          "rawSql": "SELECT\n  COALESCE(last_state, 'не определён') AS \"Штат\",\n  COUNT(*) AS \"Покупатели\"\nFROM mart.v_customer\nWHERE first_order_month >= date_trunc('month', $__timeFrom()::timestamp) AND first_order_month <= $__timeTo()::timestamp\n  AND ('*' IN ($customer_state) OR last_state IN ($customer_state))\n  AND ('*' IN ($category) OR first_category IN ($category))\nGROUP BY 1\nORDER BY 2 DESC"
