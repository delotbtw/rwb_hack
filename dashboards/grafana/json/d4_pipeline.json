          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green",
                        "index": 0
                      },
                      "published": {
                        "color": "green",
                        "index": 1
                      },
                      "failed": {
                        "color": "red",
                        "index": 2
                      },
                      "blocked": {
                        "color": "red",
                        "index": 3
                      },
                      "running": {
                        "color": "yellow",
                        "index": 4
                      }
