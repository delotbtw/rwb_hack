          "rawSql": "SELECT\n  payment_type AS \"Способ оплаты\",\n  COUNT(*) FILTER (WHERE is_revenue) AS \"Платежи\",\n  SUM(payment_value) FILTER (WHERE is_revenue) AS \"Сумма оплат\",\n  SUM(payment_value) FILTER (WHERE is_revenue)\n    / NULLIF(SUM(SUM(payment_value) FILTER (WHERE is_revenue)) OVER (), 0) AS \"Доля\",\n  AVG(installments) FILTER (WHERE is_revenue) AS \"Ср. рассрочка, мес.\"\nFROM mart.v_payment\nWHERE purchase_month >= date_trunc('month', $__timeFrom()::timestamp) AND purchase_month <= $__timeTo()::timestamp\n  AND ('*' IN ($customer_state) OR customer_state IN ($customer_state))\nGROUP BY payment_type\nORDER BY 3 DESC NULLS LAST"
