      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "capibara-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT run_id, ds, kind, status, started_at, finished_at, dq_passed || '/' || dq_total AS dq, reconcile_diff, cutoff, note FROM mart.etl_runs ORDER BY run_id DESC LIMIT 20"
        }
