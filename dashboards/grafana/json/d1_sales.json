    {
      "id": 6,
      "type": "timeseries",
      "title": "Выручка и заказы по времени",
      "description": "Выручка (столбцы, левая ось, R$) и доставленные заказы (линия, правая ось) по периодам из переменной «Детализация»: неделя, месяц или квартал по дате покупки. Заказы здесь считаются на выбранном срезе (COUNT(DISTINCT order_id)) и по периодам не суммируются.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "capibara-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "capibara-pg"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT\n  date_trunc('$gran', purchase_ts) AS time,\n  SUM(price) FILTER (WHERE is_revenue) AS \"Выручка\",\n  COUNT(DISTINCT order_id) FILTER (WHERE is_revenue) AS \"Заказы\"\nFROM mart.v_sales_item\nWHERE purchase_month >= date_trunc('month', $__timeFrom()::timestamp) AND purchase_month <= $__timeTo()::timestamp\n  AND ('*' IN ($customer_state) OR customer_state IN ($customer_state))\n  AND ('*' IN ($seller_state) OR seller_state IN ($seller_state))\n  AND ('*' IN ($category) OR category_label IN ($category))\nGROUP BY 1\nORDER BY 1"
        }
      ],
