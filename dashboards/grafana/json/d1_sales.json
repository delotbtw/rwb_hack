              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Топ-10 продавцов по выручке",
      "description": "Продавцы с наибольшей Σ price доставленных заказов на текущем срезе. «Заказы» = COUNT(DISTINCT order_id): заказ с несколькими продавцами учтён у каждого, поэтому столбец не суммируется. Экспорт: Inspect → Data → CSV.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "capibara-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "capibara-pg"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT\n  seller_id AS \"Продавец\",\n  seller_state AS \"Штат\",\n  COUNT(DISTINCT order_id) FILTER (WHERE is_revenue) AS \"Заказы\",\n  COUNT(*) FILTER (WHERE is_revenue) AS \"Единицы\",\n  SUM(price) FILTER (WHERE is_revenue) AS \"Выручка\"\nFROM mart.v_sales_item\nWHERE purchase_month >= date_trunc('month', $__timeFrom()::timestamp) AND purchase_month <= $__timeTo()::timestamp\n  AND ('*' IN ($customer_state) OR customer_state IN ($customer_state))\n  AND ('*' IN ($seller_state) OR seller_state IN ($seller_state))\n  AND ('*' IN ($category) OR category_label IN ($category))\nGROUP BY seller_id, seller_state\nORDER BY \"Выручка\" DESC NULLS LAST\nLIMIT 10"
