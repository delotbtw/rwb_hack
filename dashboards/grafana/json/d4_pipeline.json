            "uid": "capibara-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT day, check_code, batch_value, stream_value, diff, is_ok FROM mart.reconcile_result WHERE run_id = (SELECT max(run_id) FROM mart.reconcile_result) ORDER BY day, check_code"
