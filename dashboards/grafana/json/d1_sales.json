            "uid": "capibara-pg"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ROUND(SUM(order_value) FILTER (WHERE is_revenue) / NULLIF(COUNT(*) FILTER (WHERE is_revenue), 0), 2) AS avg_check\nFROM mart.order_summary\nWHERE purchase_month >= date_trunc('month', $__timeFrom()::timestamp) AND purchase_month <= $__timeTo()::timestamp\n  AND ('*' IN ($customer_state) OR customer_state IN ($customer_state))"
